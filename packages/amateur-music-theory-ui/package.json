{
  "name": "@mlt/amateur-music-theory-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Amateur Music Theory lesson launcher UI",
  "svelte": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
